# Copy to .env and fill in. `.env` is gitignored; THIS file is not, so never
# put a real key here.
#
# Provider is chosen by BLACKSTART_MODEL. Unset, it defaults to claude-sonnet-5
# and uses ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# To run on Gemini instead, set both:
#   BLACKSTART_MODEL=gemini/gemini-flash-latest
#   GEMINI_API_KEY=your-key-here
#
# Caution: the Gemini free tier allows 5 requests per minute per model. A full
# pipeline run needs more than that and rate-limits partway through, so prefer
# Anthropic for a live demo.
